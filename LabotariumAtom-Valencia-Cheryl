  {
    q: "Atom P memiliki 20 proton dan 20 neutron, atom Q memiliki 19 proton dan 21 neutron. Hubungan P dan Q adalah...",
    options: ["Isotop","Isobar","Isoton","Isomer"],
    correct: 1,
    explain: "Nomor massa P = 40 dan Q = 40 (sama), tetapi jumlah proton berbeda — ini disebut isobar."
  },
  {
    q: "Manakah pernyataan yang paling tepat menggambarkan model atom Rutherford?",
    options: [
      "Atom adalah bola pejal bermuatan positif dengan elektron tersebar merata",
      "Atom memiliki inti kecil bermuatan positif dan elektron mengelilinginya pada jarak relatif jauh",
      "Elektron menempati orbital berbentuk awan probabilitas",
      "Elektron mengelilingi inti pada lintasan dengan tingkat energi tertentu yang tetap"
    ],
    correct: 1,
    explain: "Percobaan hamburan sinar alfa Rutherford menyimpulkan atom memiliki inti padat bermuatan positif, dikelilingi elektron pada ruang yang relatif kosong."
  },
  {
    q: "Larutan gula dapat dipisahkan komponennya melalui metode...",
    options: ["Filtrasi", "Destilasi/penguapan", "Dekantasi", "Sublimasi"],
    correct: 1,
    explain: "Karena gula larut sempurna (homogen), pemisahan dilakukan dengan menguapkan pelarutnya (destilasi/evaporasi), bukan penyaringan."
  },
  {
    q: "Suatu atom memiliki notasi ₂₆⁵⁶Fe²⁺. Jumlah proton, neutron, dan elektronnya berturut-turut adalah...",
    options: ["26, 30, 24","26, 30, 28","26, 26, 24","30, 26, 24"],
    correct: 0,
    explain: "Proton = nomor atom = 26. Neutron = 56 − 26 = 30. Elektron = 26 − 2 (karena ion 2+) = 24."
  },
  {
    q: "Manakah kelompok berikut yang seluruhnya tergolong senyawa?",
    options: [
      "O₂, N₂, Fe",
      "H₂O, CO₂, NaCl",
      "Udara, air laut, kuningan",
      "Emas, perak, tembaga"
    ],
    correct: 1,
    explain: "H₂O, CO₂, dan NaCl semuanya tersusun dari dua unsur atau lebih yang berikatan kimia tetap — ciri khas senyawa."
