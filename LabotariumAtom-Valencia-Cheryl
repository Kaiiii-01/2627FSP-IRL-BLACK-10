];
let l3Index = 0;
let l3Timer = null;
let l3TimeLeft = 0;
let l3CorrectCount = 0;
const L3_DURATION = 22;
let l3Answered = false;

function startLevel3(){
  l3Index = 0;
  l3CorrectCount = 0;
  showScreen('screen-l3');
  loadQuizQuestion();
}

function renderL3Dots(){
  const wrap = document.getElementById('l3-dots');
  wrap.innerHTML = '';
  quizQuestions.forEach((_, i)=>{
    const d = document.createElement('span');
    if(i < l3Index) d.classList.add(window.l3Results[i] ? 'done' : 'fail');
    else if(i === l3Index) d.classList.add('current');
    wrap.appendChild(d);
  });
}
window.l3Results = [];

function loadQuizQuestion(){
  l3Answered = false;
  const item = quizQuestions[l3Index];
  document.getElementById('l3-question').textContent = `Soal ${l3Index+1}/${quizQuestions.length}. ${item.q}`;
  document.getElementById('l3-explain').classList.remove('show');
  document.getElementById('l3-next-wrap').style.display = 'none';
  const optWrap = document.getElementById('l3-options');
  optWrap.innerHTML = '';
  item.options.forEach((opt, i)=>{
    const b = document.createElement('button');
    b.className = 'opt';
    b.textContent = opt;
    b.onclick = () => answerQuiz(i);
    optWrap.appendChild(b);
  });
  renderL3Dots();
  startL3Timer();
}

function startL3Timer(){
  clearInterval(l3Timer);
  l3TimeLeft = L3_DURATION * 10;
  const fill = document.getElementById('l3-timer');
  fill.style.width = '100%';
  fill.style.background = 'var(--electron)';
  l3Timer = setInterval(()=>{
    l3TimeLeft--;
    const pct = (l3TimeLeft / (L3_DURATION*10)) * 100;
    fill.style.width = pct + '%';
    if(pct < 30) fill.style.background = 'var(--danger)';
    if(l3TimeLeft <= 0){
      clearInterval(l3Timer);
      answerQuiz(-1, true);
    }
  }, 100);
}

function answerQuiz(selected, timedOut){
  if(l3Answered) return;
  l3Answered = true;
  clearInterval(l3Timer);
  const item = quizQuestions[l3Index];
  const buttons = document.querySelectorAll('#l3-options .opt');
  buttons.forEach((b,i)=>{
    b.disabled = true;
    if(i === item.correct) b.classList.add('correct');
    else if(i === selected) b.classList.add('wrong');
  });
  const correct = selected === item.correct;
  window.l3Results[l3Index] = correct;
  if(correct){
    score += 150;
    l3CorrectCount++;
  }
  document.getElementById('l3-explain').textContent = item.explain;
  document.getElementById('l3-explain').classList.add('show');
  document.getElementById('l3-next-wrap').style.display = 'flex';
  updateHUD();
  renderL3Dots();

  if(!correct){
    setTimeout(()=>{ loseLife(); }, 400);
  }
}

function nextQuiz(){
  if(lives <= 0) return;
  l3Index++;
  if(l3Index >= quizQuestions.length){
    endGame(true);
  } else {
    loadQuizQuestion();
  }
}

// ============ RESULTS ============
function endGame(finished){
  clearInterval(l1Timer); clearInterval(l2Timer); clearInterval(l3Timer);
  showScreen('screen-result');
  const status = document.getElementById('result-status');
  const rank = document.getElementById('result-rank');
  const msg = document.getElementById('result-msg');

  document.getElementById('res-score').textContent = score;
  document.getElementById('res-lives').textContent = Math.max(lives,0);
  const acc = quizQuestions.length ? Math.round((l3CorrectCount / quizQuestions.length) * 100) : 0;
  document.getElementById('res-acc').textContent = acc + '%';

  if(!finished){
    status.textContent = 'MISI GAGAL';
    rank.textContent = 'Nyawa Habis';
    msg.textContent = 'Reaksi di laboratorium berhenti karena kehabisan nyawa. Pelajari kembali catatanmu dan coba lagi — ahli kimia sejati belajar dari eksperimen yang gagal.';
    return;
  }

  status.textContent = 'MISI SELESAI';
  if(score >= 1600 && lives === 3){
    rank.textContent = 'Kepala Laboratorium';
    msg.textContent = 'Skor sempurna tanpa kehilangan nyawa. Pemahamanmu tentang atom dan materi setara ahli kimia profesional.';
  } else if(score >= 1200){
    rank.textContent = 'Asisten Peneliti Senior';
    msg.textContent = 'Hasil yang solid! Sebagian besar konsep atom dan materi sudah kamu kuasai dengan baik.';
  } else if(score >= 700){
    rank.textContent = 'Asisten Laboratorium';
    msg.textContent = 'Cukup baik, tapi masih ada beberapa konsep yang perlu diperkuat lagi, terutama soal notasi isotop dan ion.';
  } else {
    rank.textContent = 'Peserta Magang';
    msg.textContent = 'Ini baru permulaan. Coba ulangi misi untuk memperkuat pemahamanmu tentang struktur atom dan klasifikasi materi.';
  }
}
